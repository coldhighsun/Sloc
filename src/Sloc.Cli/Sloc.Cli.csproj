<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Sloc.Cli</RootNamespace>
    <AssemblyName>sloc</AssemblyName>
  </PropertyGroup>

  <!--
    Self-contained single-file publish only applies when a runtime identifier is
    supplied (the CI publish job passes a RID). Without a RID the project stays
    framework-dependent so it can be packed as a .NET global tool and referenced by
    test projects (a self-contained exe cannot be referenced otherwise; NETSDK1151).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sloc</ToolCommandName>
    <PackageId>Sloc</PackageId>
    <Authors>coldhighsun</Authors>
    <Description>A .NET global CLI tool that counts code, comment, and blank lines across source files. Supports 37 languages with auto-detection, five output formats (table, JSON, HTML, CSV, Markdown), per-file detail view, and comment health indicators.</Description>
    <PackageTags>cloc;cli;sloc;lines-of-code;loc;statistics;tool</PackageTags>
    <PackageProjectUrl>https://github.com/coldhighsun/Sloc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coldhighsun/Sloc</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sloc.Core\Sloc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sloc.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
